  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 1180,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "Buongiorno."
    } ]
  }, {
    "tStartMs": 6900,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Allora, cosa prendiamo?"
    } ]
  }, {
    "tStartMs": 9880,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "Ehi, un momento! "
    } ]
  }, {
    "tStartMs": 11840,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "Comunque io non ho fame. Ho mangiato troppo a pranzo. "
    } ]
  }, {
    "tStartMs": 15240,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "Prendo solo una spremuta d’arancia…"
    } ]
  }, {
    "tStartMs": 17100,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "Ok. Io invece…"
    } ]
  }, {
    "tStartMs": 19600,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "Buongiorno, signori!"
    } ]
  }, {
    "tStartMs": 20900,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "Buongiorno. "
    } ]
  }, {
    "tStartMs": 22200,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "Dunque, io prendo…un..."
    } ]
  }, {
    "tStartMs": 25120,
    "dDurationMs": 4860,
    "segs": [ {
      "utf8": "Io vorrei una spremuta d’arancia. Ma arance rosse, eh! Con due cucchiaini di zucchero."
    } ]
  }, {
    "tStartMs": 30280,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "Bene, signora."
    } ]
  }, {
    "tStartMs": 31360,
    "dDurationMs": 4980,
    "segs": [ {
      "utf8": "Allora, per me un tramezzino con prosciutto crudo e mozzarella e..."
    } ]
  }, {
    "tStartMs": 36500,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "...una birra piccola."
    } ]
  }, {
    "tStartMs": 39620,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "Ah, avete il tiramisù fatto in casa! "
    } ]
  }, {
    "tStartMs": 41760,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Beh, questo mi va!"
    } ]
  }, {
    "tStartMs": 44400,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "Allora un tiramisù per la signora?"
    } ]
  }, {
    "tStartMs": 45900,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "Uh, anche la panna cotta! Buona! Sì, sì e anche un tè."
    } ]
  }, {
    "tStartMs": 50260,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "Ma hai già ordinato una spremuta!"
    } ]
  }, {
    "tStartMs": 51860,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "Ah già, è vero! "
    } ]
  }, {
    "tStartMs": 52960,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "Beh allora niente spremuta! Prendo un tè."
    } ]
  }, {
    "tStartMs": 55940,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "...e per me anche un caffè decaffeinato."
    } ]
  }, {
    "tStartMs": 58900,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "Prima o dopo il tramezzino?"
    } ]
  }, {
    "tStartMs": 60320,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "Uhm, prima... Anzi, dopo."
    } ]
  }, {
    "tStartMs": 63160,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "Ho capito. Allora, ripeto: per la signora…"
    } ]
  }, {
    "tStartMs": 66860,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "Ciao Valeria, come stai? "
    } ]
  }, {
    "tStartMs": 69640,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "Io sono in un caffè con Lorenzo…"
    } ]
  }, {
    "tStartMs": 73120,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": " Io ho fatto un po’ di shopping e poi ho incontrato Lorenzo… "
    } ]
  }, {
    "tStartMs": 75820,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "Ciao!"
    } ]
  }, {
    "tStartMs": 76700,
    "dDurationMs": 1216,
    "segs": [ {
      "utf8": "Ti saluta! "
    } ]
  }, {
    "tStartMs": 78560,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "Smettila! "
    } ]
  }, {
    "tStartMs": 80020,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "Ma dai! No, è Lorenzo che mi sta dando noia..."
    } ]
  }, {
    "tStartMs": 118020,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "La birra è per Lei?"
    } ]
  }, {
    "tStartMs": 119420,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Sì, la birra è per me, ma non voglio il tè…"
    } ]
  }, {
    "tStartMs": 121820,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "Io ho ordinato il tè. Ma la spremuta no, ho detto che non la volevo più…"
    } ]
  }, {
    "tStartMs": 125360,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "…Il caffè decaffeinato."
    } ]
  }, {
    "tStartMs": 126960,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "No, veramente avevo detto dopo il tramezzino…"
    } ]
  }, {
    "tStartMs": 129740,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "Tramezzino? Io qua ho una panna cotta e un tiramisù."
    } ]
  }, {
    "tStartMs": 132560,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "No, io ho ordinato solo il tiramisù! "
    } ]
  }, {
    "tStartMs": 136320,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "Che confusione! "
    } ]
  } ]
}
